# Optional: enables live carrier and line-type lookup through Numverify's API.
# Create a free key at https://numverify.com/ and set it in your server environment.
# Without a key, Number Checker continues to use its local Mauritius prefix data.
NITRO_NUMVERIFY_API_KEY=
# Optional override if your Numverify plan requires a different endpoint.
# NITRO_NUMVERIFY_BASE_URL=https://apilayer.net/api/validate
